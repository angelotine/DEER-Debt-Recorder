#:kivy 2.3.0

<PaidHistoryScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.07, 0.09, 0.13, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(65)
            padding: [dp(8), dp(10), dp(16), dp(10)]
            spacing: dp(4)
            canvas.before:
                Color:
                    rgba: (0.10, 0.13, 0.19, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: (0.65, 0.45, 0.12, 1)
                Rectangle:
                    pos: (self.x, self.y)
                    size: (self.width, dp(2))

            Button:
                text: '‹'
                size_hint_x: None
                width: dp(44)
                background_normal: ''
                background_color: (0, 0, 0, 0)
                font_size: '28sp'
                color: (0.60, 0.65, 0.75, 1)
                on_release:
                    root.manager.transition.direction = 'right'
                    root.manager.current = 'home'

            Label:
                text: 'Payment History'
                bold: True
                font_size: '19sp'
                color: (0.92, 0.94, 0.97, 1)
                halign: 'left'
                text_size: self.width, None

        # Search bar
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(14), dp(10)]
            canvas.before:
                Color:
                    rgba: (0.09, 0.12, 0.17, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            TextInput:
                id: search_input
                hint_text: '  🔍  Search history...'
                multiline: False
                on_text: root.update_list(self.text)
                padding: [dp(14), dp(10)]
                background_normal: ''
                background_color: (0.13, 0.17, 0.24, 1)
                foreground_color: (0.88, 0.91, 0.95, 1)
                hint_text_color: (0.35, 0.42, 0.52, 1)
                cursor_color: (0.65, 0.45, 0.12, 1)
                font_size: '14sp'
                canvas.after:
                    Color:
                        rgba: (0.65, 0.45, 0.12, 0.6)
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(10))
                        width: dp(1.2)

        # Empty state
        Label:
            size_hint_y: None
            height: dp(80) if not rv.data else 0
            opacity: 1 if not rv.data else 0
            text: 'No settled accounts yet.' if not rv.data else ''
            color: (0.35, 0.42, 0.52, 1)
            font_size: '14sp'
            halign: 'center'

        # List
        RecycleView:
            id: rv
            viewclass: 'SelectableButton'
            bar_width: dp(3)
            bar_color: (0.65, 0.45, 0.12, 0.5)
            bar_inactive_color: (0.65, 0.45, 0.12, 0.15)
            RecycleBoxLayout:
                default_size: None, dp(110)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'
                spacing: dp(6)
                padding: [dp(10), dp(10)]
